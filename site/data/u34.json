:"190668b9"},{"type":"fill","id":"Taburkan garam di atas telur.","q":"___ some salt on the egg.","answers":["Sprinkle","Put","Add"],"hint":"taburkan","exp":"Imperative.","k":"dc1e7e6d"},{"type":"fill","id":"Kota itu terkenal dengan batiknya.","q":"The city is famous ___ its batik.","answers":["for"],"hint":"kata depan","exp":"famous for.","k":"26fdd160"},{"type":"fill","id":"Mohon hadir pada rapat hari Senin.","q":"Please ___ the meeting on Monday.","answers":["attend"],"hint":"hadir","exp":"attend.","k":"fadee1c0"},{"type":"fill","id":"Kami tiba di Bandung kemarin malam.","q":"We ___ in Bandung last night. (arrive)","answers":["arrived"],"hint":"V2","exp":"arrived.","k":"2d17a929"},{"type":"fill","id":"Pesta akan diadakan di rumahku.","q":"The party ___ be held at my house.","answers":["will"],"hint":"akan","exp":"will be held.","k":"6e236aa2"},{"type":"mcq","q":"Jenis teks yang menceritakan pengalaman lampau:","options":["recount","procedure","descriptive","announcement"],"answer":0,"exp":"Recount.","k":"faecc5a3"},{"type":"mcq","q":"Jenis teks yang menjelaskan cara membuat sesuatu:","options":["procedure","narrative","recount","invitation"],"answer":0,"exp":"Procedure.","k":"4d16e87e"},{"type":"mcq","q":"Jenis teks yang menggambarkan ciri sebuah tempat:","options":["descriptive","procedure","recount","notice"],"answer":0,"exp":"Descriptive.","k":"b58fd2d3"},{"type":"mcq","q":"Jenis teks yang punya complication dan resolution:","options":["narrative","descriptive","procedure","notice"],"answer":0,"exp":"Narrative.","k":"0c012aca"},{"type":"mcq","q":"Mana kalimat simple present?","options":["Dina walks to school.","Dina walked to school.","Dina is walking to school.","Dina will walk to school."],"answer":0,"exp":"walks.","k":"7ea348b0"},{"type":"mcq","q":"Mana kalimat past tense?","options":["They visited Bali last year.","They visit Bali.","They are visiting Bali.","They will visit Bali."],"answer":0,"exp":"visited + last year.","k":"697c7992"},{"type":"mcq","q":"