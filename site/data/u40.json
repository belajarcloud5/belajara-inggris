u for your time and consideration","options":["Terima kasih atas waktu dan pertimbangan Anda","Aku tidak punya waktu","Pertimbangan itu salah","Terima kasih kembali"],"answer":0,"exp":"consideration = pertimbangan.","k":"15909204"},{"type":"fill","id":"Saya melamar posisi akuntan.","q":"I am ___ for the position of accountant.","answers":["applying"],"hint":"melamar","exp":"applying for.","k":"a6c99982"},{"type":"fill","id":"Saya lulus dari SMK pada tahun 2024.","q":"I ___ from vocational school in 2024. (graduate)","answers":["graduated"],"hint":"V2","exp":"graduated.","k":"51651867"},{"type":"fill","id":"Saya fasih berbahasa Inggris.","q":"I am ___ in English.","answers":["fluent"],"hint":"fasih","exp":"fluent in.","k":"91032e59"},{"type":"fill","id":"Saya dapat bekerja di bawah tekanan.","q":"I can work ___ pressure.","answers":["under"],"hint":"di bawah","exp":"under pressure.","k":"931b0f3f"},{"type":"fill","id":"Saya berharap dapat bergabung dengan tim Anda.","q":"I hope to ___ your team.","answers":["join"],"hint":"bergabung","exp":"join.","k":"d9efc95e"},{"type":"fill","id":"Terlampir adalah CV dan ijazah saya.","q":"___ are my CV and diploma.","answers":["Attached","Enclosed"],"hint":"terlampir","exp":"Attached.","k":"ee52e739"},{"type":"fill","id":"Saya siap diwawancarai kapan saja.","q":"I am ready to be ___ at any time.","answers":["interviewed"],"hint":"diwawancarai","exp":"interviewed.","k":"0ecf6de6"},{"type":"fill","id":"Hormat saya,","q":"Yours ___,","answers":["sincerely","faithfully"],"hint":"hormat","exp":"Yours sincerely.","k":"1426234e"},{"type":"fill","id":"Saya memiliki kemampuan komunikasi yang baik.","q":"I have good communication ___.","answers":["skills"],"hint":"kemampuan","exp":"skills.","k":"97c99c37"},{"type":"mcq","q":"Salam pembuka surat lamaran formal:","options":["Dear Sir or Madam,","Hi guys,","Yo!","Hello friend,"],"answer":0,"exp":"Formal.","k":"b861194c"},{"type":"mcq","q":"Paragraf pertama surat lamaran berisi...","options":[