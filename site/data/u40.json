n of assistant","options":["Saya menulis untuk melamar posisi asisten","Saya menulis surat untuk teman","Saya bekerja sebagai asisten","Saya mencari buku"],"answer":0,"exp":"apply for = melamar.","k":"11e32a04"},{"type":"listen","q":"Dengarkan. Apa artinya?","say":"I look forward to hearing from you","options":["Saya menantikan kabar dari Anda","Saya melihat ke depan","Saya mendengar suara Anda","Saya mau pergi"],"answer":0,"exp":"look forward to = menantikan.","k":"ded123c5"},{"type":"listen","q":"Dengarkan. Apa artinya?","say":"Please find my CV attached","options":["Mohon lihat CV saya yang terlampir","CV saya hilang","Saya mencari CV","CV saya sudah lama"],"answer":0,"exp":"attached = terlampir.","k":"b4a59fd8"},{"type":"fill","id":"Ada lowongan untuk kasir.","q":"There is a ___ for a cashier.","answers":["vacancy"],"hint":"lowongan","exp":"vacancy = lowongan.","k":"00ec7a25"},{"type":"fill","id":"Saya bertanggung jawab dan rajin.","q":"I am ___ and hard-working.","answers":["responsible"],"hint":"bertanggung jawab","exp":"responsible = bertanggung jawab.","k":"5a941907"},{"type":"fill","id":"Saya memiliki pengalaman dua tahun.","q":"I have two years of ___.","answers":["experience"],"hint":"pengalaman","exp":"experience = pengalaman.","k":"95c7a8e2"},{"type":"fill","id":"Saya mampu bekerja dalam tim.","q":"I am ___ to work in a team.","answers":["able"],"hint":"mampu","exp":"able to = mampu.","k":"ef494d09"},{"type":"fill","id":"Saya akan sangat berterima kasih atas kesempatan ini.","q":"I would be ___ for the opportunity.","answers":["grateful"],"hint":"berterima kasih","exp":"grateful = berterima kasih.","k":"f9528d56"},{"type":"fill","id":"Saya melihat iklan Anda di koran.","q":"I saw your ___ in the newspaper.","answers":["advertisement","advert","ad"],"hint":"iklan","exp":"advertisement = iklan.","k":"13d6d062"},{"type":"fill","id":"Saya bekerja sebagai pelayan selama setahun.","q":"I ___ as a waiter for a year. (work)","answers":["worked"],"hint":"V2","exp":"worked = bekerja (lampau).","k":"3d10a9e8"},{"type":"fill","id":"Saya sedang mempelajari desain grafis.","q":"I ___ studying graphic design now.","answers":["am"],"hint":"to be","exp":"am + V-ing.","k":"149a9cf8"},{"type":"fill","id":"Berikut saya lampirkan CV saya.","q":"Please find my CV ___.","answers":["attached","enclosed"],"hint":"terlampir","exp":"attached = terlampir.","k":"ddf5fad7"},{"type":"mcq","q":"Kalimat mana yang menyebut pengalaman?","options":["I worked as a cashier for one year.","I like pizza.","I am tall.","I live near the school."],"answer":0,"exp":"Pengalaman kerja.","k":"10224923"},{"type":"mcq","q":"Kalimat mana yang menyebut keterampilan?","options":["I am skilled in using Microsoft Excel.","I was born in 2008.","My mother is a nurse.","I have a cat."],"answer":0,"exp":"skilled in = terampil dalam.","k":"6a8c618e"},{"type":"mcq","q":"Kalimat mana yang paling cocok untuk menutup surat lamaran?","options":["Thank you for your time and consideration.","Bye bye!","See you tomorrow.","Write to me soon."],"answer":0,"exp":"Penutup formal.","k":"d734d317"},{"type":"mcq","q":"Dokumen yang berisi riwayat hidup disebut...","options":["curriculum vitae (CV)","invoice","receipt","ticket"],"answer":0,"exp":"CV = riwayat hidup.","k":"409ac072"},{"type":"mcq","q":"Dalam CV, pengalaman kerja biasanya ditulis dari...","options":["yang terbaru","yang terlama","acak","yang tidak penting"],"answer":0,"exp":"Reverse chronological order.","k":"714f31b9"},{"type":"mcq","q":"Bagian \"Objective\" pada CV berisi...","options":["tujuan karier singkat","daftar nilai","nama orang tua","alamat toko"],"answer":0,"exp":"Objective = tujuan.","k":"19050103"},{"type":"mcq","q":"Kata \"reference\" pada CV berarti...","options":["orang yang dapat memberi rekomendasi","buku bacaan","gambar","kamus"],"answer":0,"exp":"reference = rujukan/pemberi rekomendasi.","k":"f7baaa76"},{"type":"mcq","q":"Kalimat mana yang benar?","options":["I am interested in this position.","I am int